{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadly.example/spec/action-approval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "action_id",
    "expected_version",
    "payload_hash"
  ]
}
