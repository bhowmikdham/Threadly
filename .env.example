# Copy to .env and fill in. Everything works out of the box in dev mode
# (mock Gmail, stub LLM) with no external credentials.
#
# NOTE: keep comments on their OWN lines. Inline comments after values are
# parsed inconsistently across dotenv/compose versions (some keep the comment
# text as part of the value), which is exactly the kind of bug that only
# shows up on someone else's machine.

# --- global ---
# true = mock Gmail + dev auth + stub LLM
THREADLY_DEV_MODE=true
# Caddy site address (set your EC2 domain in prod)
THREADLY_DOMAIN=localhost
THREADLY_JWT_SECRET=change-me-32-chars-minimum-please
THREADLY_INTERNAL_TOKEN=change-me-internal-service-token
# Fernet key for encrypting Google OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THREADLY_FERNET_KEY=

# --- postgres ---
POSTGRES_USER=threadly
POSTGRES_PASSWORD=threadly-dev-password
POSTGRES_DB=threadly
THREADLY_DATABASE_URL=postgresql://threadly:threadly-dev-password@postgres:5432/threadly

# --- inference: primary = Mac/Ollama over Tailscale, fallback = OpenRouter ---
# e.g. http://100.x.y.z:11434 — leave empty to skip Ollama
THREADLY_OLLAMA_BASE_URL=
THREADLY_OLLAMA_MODEL=qwen3.5:4b
THREADLY_OLLAMA_SMALL_MODEL=qwen3.5:2b
THREADLY_OLLAMA_EMBED_MODEL=nomic-embed-text
# leave empty to skip OpenRouter
OPENROUTER_API_KEY=
THREADLY_OPENROUTER_MODEL=qwen/qwen3.5-9b
# AI team drop-ins; ignored if absent
THREADLY_BERT_DIR=/models/bert
THREADLY_CLASSIFIERS_DIR=/models/classifiers

# --- voice (ElevenLabs, keys server-side only) ---
# empty + dev mode = deterministic stubs
ELEVENLABS_API_KEY=
THREADLY_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- google oauth (test mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- sync ---
THREADLY_SYNC_INTERVAL_SECONDS=300
# LLM extraction for regex-missed transactional mail
THREADLY_TIER2_EXTRACTION=true
# priority/action/category labels on inbound mail
THREADLY_MESSAGE_LABELING=true
# per-user chroma cap (t3 memory)
THREADLY_RAG_MAX_DOCS_PER_USER=500

# --- limits ---
# chat requests per user per minute
THREADLY_CHAT_RATE_LIMIT=30
