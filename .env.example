# Copy to .env and fill in. Everything works out of the box in dev mode
# (mock Gmail, stub LLM) with no external credentials.

# --- global ---
THREADLY_DEV_MODE=true                # true = mock Gmail + dev auth + stub LLM fallback
THREADLY_DOMAIN=localhost             # Caddy site address (set your EC2 domain in prod)
THREADLY_JWT_SECRET=change-me-32-chars-minimum-please
THREADLY_INTERNAL_TOKEN=change-me-internal-service-token
# Fernet key for encrypting Google OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THREADLY_FERNET_KEY=

# --- postgres ---
POSTGRES_USER=threadly
POSTGRES_PASSWORD=threadly-dev-password
POSTGRES_DB=threadly
THREADLY_DATABASE_URL=postgresql://threadly:threadly-dev-password@postgres:5432/threadly

# --- inference: primary = Mac/Ollama over Tailscale, fallback = OpenRouter ---
THREADLY_OLLAMA_BASE_URL=             # e.g. http://100.x.y.z:11434 (empty = skip Ollama)
THREADLY_OLLAMA_MODEL=qwen3.5:4b
THREADLY_OLLAMA_SMALL_MODEL=qwen3.5:2b
THREADLY_OLLAMA_EMBED_MODEL=nomic-embed-text
OPENROUTER_API_KEY=                   # empty = skip OpenRouter
THREADLY_OPENROUTER_MODEL=qwen/qwen3.5-9b
THREADLY_BERT_DIR=/models/bert        # AI team drop-in; ignored if absent

# --- voice (ElevenLabs, keys server-side only) ---
ELEVENLABS_API_KEY=                   # empty + dev mode = deterministic stubs
THREADLY_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- google oauth (test mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- sync ---
THREADLY_SYNC_INTERVAL_SECONDS=300
THREADLY_TIER2_EXTRACTION=true        # LLM extraction for regex-missed transactional mail
THREADLY_MESSAGE_LABELING=true        # priority/action/category labels on inbound mail
THREADLY_RAG_MAX_DOCS_PER_USER=500    # per-user chroma cap (t3 memory)

# --- limits ---
THREADLY_CHAT_RATE_LIMIT=30           # chat requests per user per minute
