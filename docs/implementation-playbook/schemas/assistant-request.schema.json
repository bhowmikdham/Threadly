{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadly.example/spec/assistant-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "intent_hint": {
      "enum": [
        null,
        "summarise",
        "plan_schedule",
        "reply",
        "compose",
        "other"
      ]
    },
    "context_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "continuation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "question_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "task_id",
            "expected_version",
            "question_id"
          ]
        }
      ]
    },
    "draft_options": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "to": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "To",
              "type": "array"
            },
            "cc": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Cc",
              "type": "array"
            },
            "bcc": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Bcc",
              "type": "array"
            },
            "reply_message_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reply Message Id"
            }
          },
          "title": "DraftOptions",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "instruction",
    "intent_hint",
    "context_snapshot_id",
    "continuation"
  ]
}
