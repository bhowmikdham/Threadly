# Set to the public HTTPS API origin (no path) when packaging a released build.
# Such builds pin that server and ask for access to only its host on first sign-in.
# Leave unset for localhost development; the local default is 127.0.0.1:8000.
# This value is public in the extension bundle. Never put secrets in PLASMO_PUBLIC_*.
PLASMO_PUBLIC_THREADLY_BACKEND_ORIGIN=
