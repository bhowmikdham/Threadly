# ============================================================
# Threadly configuration — copy to .env and fill in.
# .env is gitignored; NEVER commit real values.
# Every variable the stack reads is documented here.
# ============================================================

# --- app ---
APP_ENV=dev                       # dev | prod. dev enables create_all + hot reload paths
SECRET_KEY=change-me              # JWT signing key. Generate: openssl rand -hex 32
JWT_TTL_MINUTES=1440              # session JWT lifetime

# --- caddy / domain (prod only) ---
DOMAIN=example.duckdns.org        # public hostname; caddy auto-provisions TLS on :443

# --- postgres (compose wires these into the postgres container too) ---
POSTGRES_USER=threadly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threadly
# api reads DATABASE_URL; inside compose the host is "postgres"
DATABASE_URL=postgresql+asyncpg://threadly:change-me@postgres:5432/threadly

# --- chroma ---
CHROMA_URL=http://chroma:8000     # inside compose network

# --- google oauth (test mode, <=100 users) + gmail api ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=              # must match the OAuth consent config
GOOGLE_ALLOW_LOOPBACK_TEST_CALLBACK=false # opt-in ONLY http://127.0.0.1:8765/oauth/callback
# Exact comma-separated callback URIs accepted by POST /auth/google/exchange.
GOOGLE_REDIRECT_URI_ALLOWLIST=
# Fernet key for encrypting refresh tokens at rest. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- inference migration (ADR 003) ---
INFERENCE_PROVIDER=legacy              # legacy | bedrock; opt in after AWS smoke test
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=                       # enabled Converse text model ID/inference profile ARN
BEDROCK_SMALL_MODEL_ID=                 # optional router model; defaults to main
BEDROCK_READ_TIMEOUT_S=90
# AWS credentials: use the SDK credential chain / workload role, never frontend keys.
# No automatic cross-provider fallback in bedrock mode.

# --- legacy inference rollback ---
OLLAMA_BASE_URL=http://100.x.y.z:11434   # tailscale IP of the Mac
MODEL_MAIN=qwen3.5:4b-threadly           # 4b + LoRA adapter (drafting/summaries)
MODEL_SMALL=qwen3.5:2b                   # voice/planner JSON fallback
OPENROUTER_API_KEY=
MODEL_FALLBACK=qwen/qwen3.5-9b           # stock 9b via openrouter
MODEL_HEALTH_TIMEOUT_S=2                 # mac health probe before falling back

# --- voice (keys stay server-side ONLY — never shipped to the extension) ---
ELEVENLABS_API_KEY=

# --- ml artifacts (mounted read-only into the api container at /ml) ---
ML_DIR=/ml

# Optional workflow registry JSON, identical on API + worker. Empty keeps native handlers.
# Generate/validate published targets with app.workflows.release; never use TSTALIASID/DRAFT.
# Activating Flows requires scoped worker IAM, a configured Bedrock router model and live evaluation.
ASSISTANT_WORKFLOW_MANIFEST=

# Dedicated action worker; default off. Real writes also require pilot membership.
EMAIL_WRITES_ENABLED=false
EMAIL_RECONCILIATION_ENABLED=false
EMAIL_ACTION_LEASE_SECONDS=120

# MVP: optional generation-only router/plan/meeting-response published Flow registry.
ASSISTANT_AUXILIARY_WORKFLOW_MANIFEST=
# Explicit local user IDs only; empty means nobody can perform real provider writes.
WRITE_PILOT_USER_IDS=
CALENDAR_WRITES_ENABLED=false
CALENDAR_RECONCILIATION_ENABLED=false
# Comma-separated: summarise,plan_schedule,reply,compose,other. Empty pauses none.
ASSISTANT_DISABLED_INTENTS=
MAILBOX_BACKGROUND_SYNC_ENABLED=false
MAILBOX_SYNC_MAX_MESSAGES=5000

# Fetch selected Gmail sources on demand; never import the mailbox.
GMAIL_SOURCE_MODE=on_demand
