{
  "name": "mail-mind",
  "displayName": "Mail Mind Extension",
  "version": "0.0.1",
  "description": "Chrome extension sidepanel interface for email task execution and summary generation.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@inboxsdk/core": "^2.2.24",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/inboxsdk": "^2.0.14",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
    "key": "",
    "permissions": [
      "sidePanel",
      "identity",
      "storage",
      "scripting"
    ],
    "web_accessible_resources": [
    {
      "resources": ["*"],
      "matches": ["https://mail.google.com/*"]
    }
    ],
    "oauth2": {
      "client_id": "1054567044769-6dk3mi16v6k1m5omlc5g8akdd94kgv1j.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.send"
      ]
    },
    "host_permissions": [
  "https://mail.google.com/*",
  "https://*.inboxsdk.com/*"
],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {
      "default_title": "Open Mail Mind"
    }
  }
}